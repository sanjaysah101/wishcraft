{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": { "@/*": ["web/src/*"] }
  },
  "include": ["web/src", "tests", "vite.config.ts"]
}
